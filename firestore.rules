rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 兼務申請：投稿(create)は検証付きで公開、閲覧(read)・削除(delete)は認証済み管理者のみ、更新(update)は禁止
    match /concurrent_works/{id} {
      allow create: if request.resource.data.applicationType in ['part-time', 'general']
                    && request.resource.data.createdAt == request.time;
      allow read, delete: if request.auth != null;
      allow update: if false;
    }

    // お知らせ：公開読み取り、クライアントからの書き込み禁止
    match /notices/{id} {
      allow read: if true;
      allow write: if false;
    }

    // 助手室依頼台帳：共同編集のため認証なしで read/write（設計上の意図）
    match /assistant_requests/{id} {
      allow read, write: if true;
    }

    // 上記以外はすべて拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
